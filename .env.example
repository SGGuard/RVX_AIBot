# ============================================
# RVX Bot - Environment Variables Template
# ============================================
# Copy this file to .env and replace placeholders locally.
# Never commit .env or paste real credentials into source control.

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token

# Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1500
GEMINI_TIMEOUT=30

# API server
# Use a long random value in local/production secret storage.
ADMIN_TOKEN=replace_with_a_long_random_admin_token
PORT=8000
HOST=127.0.0.1
USER_ID_SIGNING_SECRET=replace_with_at_least_32_random_characters
FORWARDED_ALLOW_IPS=127.0.0.1,::1
BACKEND_URL=http://localhost:8000
MAX_TEXT_LENGTH=4096

# CoinGecko (optional)
COINGECKO_API_KEY=replace_with_your_coingecko_api_key

# Feature flags
CRYPTO_DIGEST_ENABLED=true
PRICE_MONITORING_ENABLED=true
MARKET_ANALYSIS_ENABLED=true
PORTFOLIO_TRACKING_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Rate limiting
MAX_REQUESTS_PER_MINUTE=30

# Cache
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL=3600
